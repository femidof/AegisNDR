TENANT_ID=11111111-1111-4111-8111-111111111111
DEPLOYMENT_ID=22222222-2222-4222-8222-222222222222
CLICKHOUSE_DATABASE=hybrid_ndr
CLICKHOUSE_USER=hybrid_ndr
CLICKHOUSE_PASSWORD=replace-with-generated-secret
SURICATA_SENSOR_ID=sensor-suricata-01
ZEEK_SENSOR_ID=sensor-zeek-01
# Explicit deterministic PCAP mode for development and acceptance. The signed
# installer renders live/host capture and its validated --interface value.
SENSOR_CAPTURE_MODE=pcap
SENSOR_NETWORK_MODE=none
CAPTURE_INTERFACE=lo
LOGTO_POSTGRES_DB=logto
LOGTO_POSTGRES_USER=logto
LOGTO_POSTGRES_PASSWORD=replace-with-generated-secret
LOGTO_DATABASE_STATEMENT_TIMEOUT=5000
LOGTO_ENDPOINT=http://localhost:3011
LOGTO_ADMIN_ENDPOINT=http://localhost:3012
# Browser-reachable URL. Non-localhost LAN clients require the HTTPS name
# configured as Logto's public endpoint; WebCrypto deliberately rejects
# insecure HTTP origins during the PKCE flow.
LOGTO_PUBLIC_ENDPOINT=http://localhost:3011
LOGTO_DASHBOARD_CLIENT_ID=replace-after-logto-bootstrap
LOGTO_ORGANIZATION_ID=replace-after-logto-bootstrap
LOGTO_CLOUD_PORTAL_CLIENT_ID=replace-after-logto-bootstrap
LOGTO_CLOUD_PORTAL_ORGANIZATION_ID=replace-after-logto-bootstrap
CLOUD_PORTAL_PUBLIC_ORIGIN=http://localhost:4180
LOGTO_CLOUD_PORTAL_REDIRECT_URI=http://localhost:4180/callback
LOGTO_CLOUD_PORTAL_POST_LOGOUT_URI=http://localhost:4180
LOGTO_CLOUD_PORTAL_SCOPES=
DASHBOARD_MODE=api
DASHBOARD_AUTH_MODE=oidc
DASHBOARD_ALLOW_INSECURE_HTTP=true
DASHBOARD_PUBLIC_ORIGIN=http://localhost:4173
LOGTO_REDIRECT_URI=http://localhost:4173/callback
LOGTO_POST_LOGOUT_URI=http://localhost:4173
AUTH_MODE=jwt
AUTH_AUDIENCE=https://hybrid-ndr.local/api
# Development workflow only: the local HTTP Logto listener is on the Docker
# network, so its JWKS fetch is explicitly unauthenticated-TLS. The installer
# never sets this flag; production fetches the JWKS over verified HTTPS
# (docker-compose.https.yml routes it through the TLS ingress) or uses the
# standalone local JWKS, and AUTH_JWKS_URL must then be https.
AUTH_JWKS_URL=http://logto:3001/oidc/jwks
AUTH_JWKS_ALLOW_INSECURE_HTTP=true
# Optional defense-in-depth after bootstrap.py prints the generated Logto organization ID.
AUTH_ALLOWED_ORGANIZATION_IDS=
CONTROL_PORTAL_AUTH_MODE=jwt
CONTROL_PORTAL_AUTH_ISSUER=http://localhost:3011/oidc
CONTROL_PORTAL_AUTH_AUDIENCE=https://hybrid-ndr.cloud/api
# Development workflow only; production requires verified HTTPS.
CONTROL_PORTAL_AUTH_JWKS_URL=http://logto:3001/oidc/jwks
CONTROL_PORTAL_AUTH_JWKS_ALLOW_INSECURE_HTTP=true
CONTROL_PORTAL_AUTH_ALLOWED_ORGANIZATION_IDS=
CONTROL_PORTAL_AUTH_REVOKED_TOKEN_IDS=
CONTROL_PORTAL_AUTH_REVOKED_SESSION_IDS=
CONTROL_IDENTITY_ISSUER=http://localhost:3011/oidc
CONTROL_IDENTITY_JWKS_URI=http://localhost:3011/oidc/jwks
PERSISTENCE_PROFILE=production
PERSISTENCE_READINESS_REQUIRED=true
POSTGRES_DB=hybrid_ndr
POSTGRES_USER=hybrid_ndr
POSTGRES_PASSWORD=replace-with-generated-secret
POSTGRES_EXPORTER_USER=ndr_metrics
POSTGRES_EXPORTER_PASSWORD=replace-with-generated-secret
GRAFANA_POSTGRES_USER=ndr_grafana
GRAFANA_POSTGRES_PASSWORD=replace-with-generated-secret
MINIO_ROOT_USER=hybrid_ndr
MINIO_ROOT_PASSWORD=replace-with-generated-secret
MINIO_RAW_BUCKET=ndr-raw-evidence
MINIO_CASE_BUCKET=ndr-case-evidence
MINIO_EXPORT_BUCKET=ndr-investigation-exports
MINIO_RAW_RETENTION_DAYS=30
MINIO_CASE_RETENTION_DAYS=365
MINIO_EXPORT_RETENTION_DAYS=30
GRAFANA_ADMIN_USER=ndr-admin
GRAFANA_ADMIN_PASSWORD=replace-with-generated-secret
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
MODEL_POLICY=balanced
MODEL_GATEWAY_AVAILABLE=true
OFFLINE_GRACE_DAYS=14
DETECTION_POLL_SECONDS=2
DETECTION_FAST_INTERVAL_SECONDS=10
DETECTION_BEHAVIOR_INTERVAL_SECONDS=60
DETECTION_TUNNELING_INTERVAL_SECONDS=300
DETECTION_BASELINE_INTERVAL_SECONDS=3600
DETECTION_BASELINE_WINDOW_DAYS=7
DETECTION_BASELINE_EXCLUSION_SECONDS=300
DETECTION_BOOTSTRAP_LOOKBACK_SECONDS=86400
DETECTION_MAX_EVENTS_PER_WINDOW=10000
DETECTION_BACKEND_TIMEOUT_SECONDS=10
DETECTION_HEALTH_TTL_SECONDS=30
DETECTION_MODEL_RETRAIN_INTERVAL_SECONDS=86400
OPERATIONS_POLL_SECONDS=15
OPERATIONS_HEALTH_SNAPSHOT_SECONDS=3600
RETENTION_INTERVAL_SECONDS=86400
CLICKHOUSE_EVENT_RETENTION_DAYS=30
POSTGRES_EVENT_RETENTION_DAYS=30
OPERATIONAL_HISTORY_RETENTION_DAYS=90
OTEL_SDK_DISABLED=false
CUSTOMER_BIND_ADDRESS=0.0.0.0
# Base-Compose HTTP values above are for explicit development only. Production
# adds docker-compose.https.yml and replaces these with the trusted LAN origin.
CUSTOMER_LAN_HOST=hybrid-ndr.local
HYBRID_NDR_TLS_CERT_FILE=./.runtime/tls/server-cert.pem
HYBRID_NDR_TLS_KEY_FILE=./.runtime/tls/server-key.pem
HYBRID_NDR_TLS_CA_FILE=./.runtime/tls/ca-cert.pem
# The recurring connector remains in standby for the deterministic local stack.
# The installer enables it after enrollment and mounts the persisted identity.
CONNECTOR_ENABLED=false
CONTROL_PLANE_URL=
CONTROL_PLANE_CA_FILE=
CONTROL_PLANE_ALLOW_INSECURE_LOOPBACK=false
HYBRID_NDR_STATE_DIR=./.runtime
HYBRID_NDR_RELEASE_VERSION=0.1.0
CONNECTOR_HEARTBEAT_SECONDS=60
CONNECTOR_USAGE_SECONDS=300
CONNECTOR_CONFIGURATION_SECONDS=300
CONNECTOR_UPDATE_SECONDS=3600
CONNECTOR_UPDATE_MANIFEST_FILE=/var/lib/hybrid-ndr/updates/available-manifest.json
CONNECTOR_CERTIFICATE_CHECK_SECONDS=21600
CONNECTOR_CERTIFICATE_ROTATE_BEFORE_DAYS=30
UPDATE_AGENT_MONITOR_SECONDS=30

# Vendor development defaults. Production must use HTTP provider mode, mTLS,
# secret files, and an independently verified zero-retention provider contract.
CONTROL_API_ALLOW_INSECURE_FINGERPRINT_HEADER=true
CONTROL_API_PUBLIC_URL=http://control-api:8081/v1
MODEL_GATEWAY_PUBLIC_URL=http://model-gateway:8082/v1/model/investigate
MODEL_PROVIDER_MODE=demo
MODEL_PROVIDER_NAME=demo-zero-retention
MODEL_PROVIDER_ENDPOINT=https://provider.invalid/v1/chat/completions
MODEL_PROVIDER_API_KEY=development-not-used-in-demo-mode
MODEL_PROVIDER_REGION=us
MODEL_PROVIDER_ZERO_RETENTION_VERIFIED=true
MODEL_PROVIDER_CACHE_DISABLED=true
# Stream chat completions over SSE from OpenAI-compatible endpoints (true/false).
MODEL_PROVIDER_STREAM=false
MODEL_GATEWAY_SIGNING_KEY=development-standalone-signing-key-change-me
MODEL_GATEWAY_ALLOW_INSECURE_FINGERPRINT_HEADER=true

# --- Air-gapped (standalone) mode only ---
# Written by `install.sh --standalone`; empty in vendor-enrolled deployments.
# The local API serves the JWKS at /api/v1/system/jwks and issues short-lived
# analyst tokens through /api/v1/system/standalone-login.
AUTH_STANDALONE_ISSUER_KEY_FILE=
AUTH_STANDALONE_JWKS_FILE=
AUTH_STANDALONE_LOGIN_SECRET=

# Prometheus scrape token for the operations-agent metrics endpoint. The
# installer generates and persists this; empty keeps the dev endpoint open.
OPERATIONS_METRICS_TOKEN=

# --- Grafana Logto OIDC (optional) ---
# Create a Logto application with openid/profile/email scopes and redirect URI
# https://<lan-host>/grafana/login/generic_oauth, then set these values. When
# unset, Grafana uses its local admin credentials only.
LOGTO_GRAFANA_CLIENT_ID=
LOGTO_GRAFANA_CLIENT_SECRET=
